{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/trajectory-v1.json",
  "title": "Raw factual policy trajectory",
  "type": "object",
  "required": ["policy_id", "episode_id", "context", "outcome", "return", "terminated", "truncated", "steps"],
  "properties": {
    "policy_id": {"type": "string", "minLength": 1},
    "episode_id": {"type": "string", "minLength": 1},
    "context": {"type": "object"},
    "outcome": {"type": "string"},
    "return": {"type": "number"},
    "length": {"type": "integer", "minimum": 1},
    "terminated": {"type": "boolean"},
    "truncated": {"type": "boolean"},
    "metadata": {"type": "object"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["t", "action", "reward", "state", "events", "predicates"],
        "properties": {
          "t": {"type": "integer", "minimum": 0},
          "action": {"type": ["string", "integer"]},
          "reward": {"type": "number"},
          "state": {"type": "object"},
          "events": {"type": "array", "items": {"type": "string"}},
          "predicates": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

